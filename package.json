{
  "name": "brightbean-studio",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:web": "pnpm --filter @brightbean/web dev",
    "dev:api": "pnpm --filter @brightbean/api start:dev",
    "dev:worker": "pnpm --filter @brightbean/worker start:dev",
    "build": "pnpm -r build",
    "lint": "eslint apps packages --ext .ts,.tsx",
    "format": "prettier --write \"apps/**/*.{ts,tsx}\" \"packages/**/*.{ts,tsx}\" \"tools/**/*.{ts,tsx}\"",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:migrate": "pnpm --filter @brightbean/api prisma migrate dev",
    "db:seed": "pnpm --filter @brightbean/api db:seed",
    "e2e": "pnpm --filter @brightbean/web e2e"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0"
  },
  "pnpm": {
    "overrides": {
      "fastify": "^5.12.0"
    },
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "@swc/core",
      "esbuild",
      "prisma"
    ]
  }
}